<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Library Management System</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: Arial, sans-serif;
        }

        body {
            background-color: #f4f6f9;
            color: #333;
        }

        /* Navigation Bar */
        .navbar {
            background-color: #2c3e50;
            color: white;
            padding: 18px 40px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .navbar h1 {
            font-size: 25px;
        }

        .navbar ul {
            list-style: none;
            display: flex;
            gap: 25px;
        }

        .navbar ul li a {
            color: white;
            text-decoration: none;
            font-size: 16px;
        }

        .navbar ul li a:hover {
            color: #1abc9c;
        }

        /* Main Container */
        .container {
            width: 90%;
            max-width: 1200px;
            margin: 30px auto;
        }

        .welcome {
            margin-bottom: 25px;
        }

        .welcome h2 {
            color: #2c3e50;
            margin-bottom: 8px;
        }

        /* Statistics Cards */
        .cards {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 20px;
            margin-bottom: 30px;
        }

        .card {
            background: white;
            padding: 25px;
            border-radius: 10px;
            box-shadow: 0 3px 10px rgba(0,0,0,0.1);
            text-align: center;
        }

        .card h3 {
            color: #777;
            margin-bottom: 10px;
        }

        .card p {
            font-size: 28px;
            font-weight: bold;
            color: #1abc9c;
        }

        /* Search */
        .search-box {
            background: white;
            padding: 20px;
            border-radius: 10px;
            margin-bottom: 25px;
            box-shadow: 0 3px 10px rgba(0,0,0,0.08);
        }

        .search-box input {
            width: 80%;
            padding: 12px;
            border: 1px solid #ccc;
            border-radius: 5px;
            font-size: 16px;
        }

        .search-box button {
            padding: 12px 20px;
            border: none;
            background-color: #1abc9c;
            color: white;
            border-radius: 5px;
            cursor: pointer;
        }

        .search-box button:hover {
            background-color: #16a085;
        }

        /* Books Table */
        .books {
            background: white;
            padding: 20px;
            border-radius: 10px;
            box-shadow: 0 3px 10px rgba(0,0,0,0.08);
        }

        .books h2 {
            margin-bottom: 20px;
            color: #2c3e50;
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        th, td {
            padding: 14px;
            text-align: left;
            border-bottom: 1px solid #ddd;
        }

        th {
            background-color: #2c3e50;
            color: white;
        }

        tr:hover {
            background-color: #f5f5f5;
        }

        .available {
            color: #27ae60;
            font-weight: bold;
        }

        .issued {
            color: #e74c3c;
            font-weight: bold;
        }

        /* Footer */
        footer {
            margin-top: 40px;
            background-color: #2c3e50;
            color: white;
            text-align: center;
            padding: 20px;
        }

        /* Responsive Design */
        @media (max-width: 800px) {
            .cards {
                grid-template-columns: repeat(2, 1fr);
            }

            .navbar {
                flex-direction: column;
                gap: 15px;
            }

            .search-box input {
                width: 70%;
            }
        }

        @media (max-width: 500px) {
            .cards {
                grid-template-columns: 1fr;
            }

            .navbar ul {
                flex-direction: column;
                text-align: center;
                gap: 10px;
            }

            .search-box input {
                width: 100%;
                margin-bottom: 10px;
            }

            .search-box button {
                width: 100%;
            }

            table {
                font-size: 12px;
            }
        }
    </style>
</head>

<body>

    <!-- Navigation -->
    <nav class="navbar">
        <h1>📚 Library Management</h1>

        <ul>
            <li><a href="#">Home</a></li>
            <li><a href="#">Books</a></li>
            <li><a href="#">Members</a></li>
            <li><a href="#">Issue Book</a></li>
            <li><a href="#">Logout</a></li>
        </ul>
    </nav>

    <!-- Main Content -->
    <div class="container">

        <div class="welcome">
            <h2>Welcome to the Library</h2>
            <p>Manage books, members, and issued books from one place.</p>
        </div>

        <!-- Statistics -->
        <div class="cards">
            <div class="card">
                <h3>Total Books</h3>
                <p>1,250</p>
            </div>

            <div class="card">
                <h3>Available Books</h3>
                <p>950</p>
            </div>

            <div class="card">
                <h3>Issued Books</h3>
                <p>300</p>
            </div>

            <div class="card">
                <h3>Total Members</h3>
                <p>520</p>
            </div>
        </div>

        <!-- Search -->
        <div class="search-box">
            <input type="text" placeholder="Search for a book...">
            <button>Search</button>
        </div>

        <!-- Books -->
        <div class="books">
            <h2>Book List</h2>

            <table>
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Book Name</th>
                        <th>Author</th>
                        <th>Category</th>
                        <th>Status</th>
                    </tr>
                </thead>

                <tbody>
                    <tr>
                        <td>101</td>
                        <td>Clean Code</td>
                        <td>Robert C. Martin</td>
                        <td>Programming</td>
                        <td class="available">Available</td>
                    </tr>

                    <tr>
                        <td>102</td>
                        <td>The Alchemist</td>
                        <td>Paulo Coelho</td>
                        <td>Fiction</td>
                        <td class="issued">Issued</td>
                    </tr>

                    <tr>
                        <td>103</td>
                        <td>Atomic Habits</td>
                        <td>James Clear</td>
                        <td>Self Help</td>
                        <td class="available">Available</td>
                    </tr>

                    <tr>
                        <td>104</td>
                        <td>Harry Potter</td>
                        <td>J. K. Rowling</td>
                        <td>Fantasy</td>
                        <td class="issued">Issued</td>
                    </tr>

                    <tr>
                        <td>105</td>
                        <td>Introduction to Algorithms</td>
                        <td>Thomas H. Cormen</td>
                        <td>Computer Science</td>
                        <td class="available">Available</td>
                    </tr>
                </tbody>
            </table>
        </div>

    </div>

    <!-- Footer -->
    <footer>
        <p>&copy; 2026 Library Management System. All Rights Reserved.</p>
    </footer>

</body>
</html>
